# Copy to .env and fill in. The MCP server reads these at launch.
# You don't need ALL keys — the server only complains when a worker
# on a missing provider is actually called.

# --- Paid (flat-rate or per-token) ---
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...
OPENCODE_API_KEY=sk-...

# --- Free providers (sign up, no credit card) ---
GROQ_API_KEY=gsk_...
SAMBANOVA_API_KEY=...
