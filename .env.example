# Copy to .env and fill in locally. Never commit .env or paste keys into chat.
# The setup wizard is safer than editing this template by hand:
#   python setup_model_orchestra.py

# --- Model Orchestra gateway key order (MCP calls) ---
C_LITE_1_API_KEY=
C_LITE_2_API_KEY=
C_PRO_API_KEY=

# --- Dedicated 68886868 worker credentials ---
KIMI_GW_KEY=
GROK_GW_KEY=

# --- Optional worker providers ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=

# Legacy gateway compatibility; used only if the three named keys are absent.
API_68886868_KEY=
